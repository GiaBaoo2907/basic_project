            function normalizeHeader(value) { return String(value || "").trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d").replace(/[^a-z0-9]/g, ""); }
            var header = rows[0].map(normalizeHeader);
            var columns = [
                ["equipment", ["thiết bị", "tên thiết bị", "vật tư"]], ["document", ["tài liệu", "tài liệu đính kèm", "tên tài liệu"]],
                ["purchase", ["ngày mua bh", "ngày mua bảo hiểm", "ngày mua"]], ["expiry", ["ngày đến hạn", "ngày hết hạn"]],
                ["value", ["giá trị"]], ["premium", ["phí bảo hiểm"]], ["quantity", ["số lượng"]],
                ["insurance", ["loại bảo hiểm"]], ["contract", ["số hợp đồng", "số hợp đồng bảo hiểm"]], ["supplier", ["nhà cung cấp"]]
            ];
            var indexes = {};
            columns.forEach(function (column) { var names = column[1].map(normalizeHeader); indexes[column[0]] = header.findIndex(function (h) { return names.indexOf(h) >= 0; }); });
            if (columns.some(function (column) { return indexes[column[0]] < 0; })) { error("Tiêu đề CSV chưa đủ 10 cột theo mẫu. Nhà cung cấp phải là cột cuối cùng."); return; }
            function get(c, name) { return c[indexes[name]] || ""; }
            assetRows = [];
            refreshAssetGrid();
            rows.slice(1).forEach(function (c) {
                if (!c.some(function (v) { return v.trim() !== ""; })) return;
                addAsset({ Equipment:get(c,"equipment"), PurchaseDate:parseCsvDate(get(c,"purchase")), ExpiryDate:parseCsvDate(get(c,"expiry")), Value:csvNumber(get(c,"value")), Premium:csvNumber(get(c,"premium")), Quantity:csvNumber(get(c,"quantity")) || 1, InsuranceType:get(c,"insurance"), ContractNumber:get(c,"contract"), Supplier:get(c,"supplier"), DocumentName:get(c,"document") });
            });
        };
        reader.readAsArrayBuffer(this.files[0]);
        this.value = "";
    });
    if (isEdit) loadRequest(); else setFieldValue("CreatedDate", localDateString(new Date()));
