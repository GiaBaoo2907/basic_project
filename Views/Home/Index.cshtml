@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Danh sách phiếu";
}

<!-- DevExtreme CSS (CDN) -->
<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/22.2.6/css/dx.common.css" />
<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/22.2.6/css/dx.light.css" />

<style>
    .toolbar-container {
        margin: 12px 16px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .search-and-filter {
        margin-left: auto;
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .dx-datagrid .title-column {
        font-weight: 700;
    }

    .request-link { color: #000000; text-decoration: none; cursor: pointer; }
    .request-link:hover { text-decoration: underline; }

    .action-btn {
        margin-left: 6px;
    }
</style>

<div class="toolbar-container">
    <div id="addButton"></div>
    <div id="reportButton"></div>

    <div class="search-and-filter">
        <div id="searchBox" style="width:420px;"></div>
        <div id="yearSelect" style="width:180px;"></div>
    </div>
</div>

<div id="gridContainer" style="padding:0 12px;"></div>

@section scripts {
    <script src="https://cdn3.devexpress.com/jslib/22.2.6/js/dx.all.js"></script>

    <script>
    $(function () {
        var apiBase = "@Url.Content("~/api/requestapi")";

        $("#addButton").dxButton({
            text: "Tạo phiếu", icon: "plus", type: "default", stylingMode: "contained",
            onClick: function () {
                window.location.href = "@Url.Action("Create", "Request")";
            }
        });

        $("#reportButton").dxButton({
            text: "Thống kê & Báo cáo", icon: "chart", type: "normal", stylingMode: "outlined",
            onClick: function () { window.location.href = "@Url.Action("Index", "Report")"; }
        });

        var searchTerm = "";
        var selectedYear = null;
        var cachedRows = null;
        var yearSelect = null;
        var availableYears = [new Date().getFullYear()];

        function normalizeVietnamese(value) {
            var text = String(value || "").toLowerCase().replace(/đ/g, "d");
            if (typeof text.normalize === "function") {
                try {
                    return text.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
                } catch (ignore) { }
            }

            // Fallback for browsers that do not implement String.prototype.normalize().
            var accentGroups = [
                { base: "a", chars: "àáạảãâầấậẩẫăằắặẳẵ" },
                { base: "e", chars: "èéẹẻẽêềếệểễ" },
                { base: "i", chars: "ìíịỉĩ" },
                { base: "o", chars: "òóọỏõôồốộổỗơờớợởỡ" },
                { base: "u", chars: "ùúụủũưừứựửữ" },
                { base: "y", chars: "ỳýỵỷỹ" }
            ];
            accentGroups.forEach(function (group) {
                text = text.replace(new RegExp("[" + group.chars + "]", "g"), group.base);
            });
            return text;
        }

        function getCreatedYear(value) {
            if (!value) return null;
            var match = /\/Date\((\d+)\)\//.exec(value);
            var date = new Date(match ? Number(match[1]) : value);
            return isNaN(date.getTime()) ? null : date.getFullYear();
        }

        function getField(row, name) {
            return row[name] != null ? row[name] : row[name.charAt(0).toLowerCase() + name.substring(1)];
        }

        function updateYearOptions(rows) {
            var yearSet = {};
            yearSet[new Date().getFullYear()] = true;
            if (selectedYear) yearSet[selectedYear] = true;
            rows.forEach(function (row) {
                var year = getCreatedYear(getField(row, "CreatedDate"));
                if (year) yearSet[year] = true;
            });
            availableYears = Object.keys(yearSet).map(Number).sort(function (a, b) { return b - a; });
            if (yearSelect) yearSelect.option("items", availableYears);
        }

        var store = new DevExpress.data.CustomStore({
            key: "Id",
            load: function () {
                var request = cachedRows
                    ? $.Deferred().resolve(cachedRows).promise()
                    : $.getJSON(apiBase).then(function (result) {
                        cachedRows = Array.isArray(result) ? result : (result.data || []);
                        return cachedRows;
                    });
                return request.then(function (rows) {
                    updateYearOptions(rows);
                    var term = normalizeVietnamese(searchTerm);
                    var filtered = rows.filter(function (row) {
                        if (selectedYear && getCreatedYear(getField(row, "CreatedDate")) !== selectedYear) return false;
                        if (!term) return true;
                        if (!row._normalizedSearchText) {
                            row._normalizedSearchText = normalizeVietnamese([
                                getField(row, "Code"), getField(row, "Title"), getField(row, "Creator"), getField(row, "DepartmentProject")
                            ].join(" "));
                        }
                        return row._normalizedSearchText.indexOf(term) !== -1;
                    });
                    return { data: filtered, totalCount: filtered.length };
                }).fail(function (xhr) {
                    cachedRows = null;
                    var message = xhr && xhr.responseJSON && (xhr.responseJSON.Message || xhr.responseJSON.message);
                    if (!message && xhr && !xhr.status && xhr.message)
                        message = "Lỗi xử lý dữ liệu trên trình duyệt: " + xhr.message;
                    if (!message && xhr && xhr.status)
                        message = "HTTP " + xhr.status + " - " + (xhr.statusText || "API trả về lỗi.");
                    alert("Không tải được danh sách phiếu: " + (message || "Không kết nối được API. Hãy kiểm tra máy chủ và địa chỉ trang web."));
                    throw xhr;
                });
            }
        });

        var grid = $("#gridContainer").dxDataGrid({
            dataSource: store,
            remoteOperations: false,
            showBorders: false,
            rowAlternationEnabled: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            hoverStateEnabled: true,
            paging: { pageSize: 20 },
            pager: { visible: true },
            columns: [
                {
                    caption: "STT", width: 70, alignment: "center",
                    cellTemplate: function (container, options) {
                        var pageIndex = options.component.pageIndex ? options.component.pageIndex() : 0;
                        var pageSize = options.component.pageSize ? options.component.pageSize() : 20;
                        container.text(pageIndex * pageSize + options.rowIndex + 1);
                    }
                },
                {
                    dataField: "Code", caption: "Mã phiếu yêu cầu", width: 180,
                    cellTemplate: function (container, options) {
                        var id = options.data.Id != null ? options.data.Id : options.data.id;
                        $("<a>").addClass("request-link").attr("href", "@Url.Action("Display", "Request")?id=" + encodeURIComponent(id)).text(options.value || "").appendTo(container);
                    }
                },
                {
                    dataField: "Title", caption: "Tiêu đề",
                    cellTemplate: function (container, options) {
                        var id = options.data.Id != null ? options.data.Id : options.data.id;
                        $("<a>").addClass("request-link title-column").attr("href", "@Url.Action("Display", "Request")?id=" + encodeURIComponent(id)).text(options.value || "").appendTo(container);
                    }
                },
                { dataField: "Creator", caption: "Người lập", width: 260 },
                { dataField: "CreatedDate", caption: "Ngày lập", dataType: "date", format: "dd/MM/yyyy", width: 130, alignment: "center", sortOrder: "desc" },
                {
                    caption: "Thao tác", width: 110, allowSorting: false,
                    cellTemplate: function (container, options) {
                        var $edit = $("<div>").dxButton({
                            icon: "edit",
                            stylingMode: "text",
                            onClick: function () {
                                var id = options.data.Id != null ? options.data.Id : options.data.id;
                                if (!id) {
                                    alert("Không tìm thấy mã bản ghi để mở trang sửa.");
                                    return;
                                }
                                window.location.href = "@Url.Action("Edit", "Request")?id=" + encodeURIComponent(id);
                            }
                        }).addClass("action-btn");
                        var $del = $("<div>").dxButton({
                            icon: "trash",
                            stylingMode: "text",
                            type: "danger",
                            onClick: function () {
                                if (!confirm("Xóa phiếu " + options.data.Code + "? Dữ liệu vẫn được giữ trong cơ sở dữ liệu.")) return;
                                $.ajax({ url: apiBase + "/" + options.data.Id, method: "DELETE" })
                                    .done(function () {
                                        cachedRows = null;
                                        grid.refresh();
                                    })
                                    .fail(function (xhr) {
                                        var message = xhr.responseJSON && (xhr.responseJSON.Message || xhr.responseJSON.message);
                                        alert("Không xóa được phiếu: " + (message || xhr.statusText || "Lỗi kết nối."));
                                    });
                            }
                        }).addClass("action-btn");
                        container.append($edit).append($del);
                    }
                }
            ]
        }).dxDataGrid("instance");

        $("#searchBox").dxTextBox({
            placeholder: "Tìm kiếm ...",
            valueChangeEvent: "input",
            onValueChanged: function (e) {
                searchTerm = (e.value || "").trim();
                grid.pageIndex(0);
                grid.refresh();
            }
        });

        yearSelect = $("#yearSelect").dxSelectBox({
            items: availableYears,
            placeholder: "Năm kiểm tra",
            showClearButton: true,
            onValueChanged: function (e) {
                selectedYear = e.value || null;
                grid.pageIndex(0);
                grid.refresh();
            }
        }).dxSelectBox("instance");
    });
    </script>
}
